build/
.vscode/
.DS_Store
.cache/

# Render corpus never commits the large, regenerable scene snapshots.
render/**/*.state
# Overlay capture logs include local validation timings.
render/Benchmarks/Overlays/**/*.log

# Latex
paper/**/*.aux
paper/**/*.fdb_latexmk
paper/**/*.fls
paper/**/*.log
paper/**/*.bbl
paper/**/*.blg
paper/**/*.out
paper/**/*.synctex.gz
compile_commands.json

# Tetrahedralizer mesh corpora, set up by script/SetupTetCorpus.
external/TetCorpus/

res/benchmarks/*
!res/benchmarks/Overlays/
benchmark_results/

# Python bytecode.
__pycache__/

# Render corpus candidates rendered by script/RenderFidelity.
render_candidates/
