#!/usr/bin/env python3
"""Check written, read and rewritten Metal pipeline archives, concurrent writers and capture cleanup on exit."""

import argparse
from concurrent.futures import ThreadPoolExecutor
import json
from pathlib import Path
import subprocess
import tempfile

root = Path(__file__).resolve().parents[1]
cli = argparse.ArgumentParser(description=__doc__)
cli.add_argument("--app", type=Path, default=root / "build/MeshEditorPipelineCacheTest")
app = cli.parse_args().app.resolve()
cache = (
    Path(subprocess.check_output(["getconf", "DARWIN_USER_CACHE_DIR"], text=True).strip())
    / "com.apple.gpuarchiver"
)
cache.mkdir(exist_ok=True)
with tempfile.TemporaryDirectory() as scratch, tempfile.TemporaryDirectory(
    prefix="gpuarchiver-unrelated-", dir=cache
) as foreign:
    work = Path(scratch)
    (work / "CacheTest.metal").write_text(
        "#include <metal_stdlib>\nkernel void CacheTest(device float *p) { p[0] = 1; }\n"
        "kernel void CacheTestSecond(device float *p) { p[0] = 2; }\n"
    )
    sentinel = Path(foreign) / "keep"
    sentinel.write_text("foreign data")
    before = set(cache.iterdir())

    def run(archive, mode):
        result = subprocess.run(
            [app, work, work / (archive + ".mtl4a"), mode], check=True, stdout=subprocess.PIPE, text=True
        )
        return json.loads(result.stdout) if mode != "unwind" else None

    written, served = {"hits": 0, "compiled": 2}, {"hits": 2, "compiled": 0}
    assert run("pipelines", "read") == written
    assert run("pipelines", "write") == written
    assert run("pipelines", "read") == served
    # A rewrite takes its binaries from the archive it replaces and holds every pipeline again.
    assert run("pipelines", "write") == written
    assert run("pipelines", "read") == served
    run("unwind", "unwind")
    parallel = [f"parallel-{i}" for i in range(4)]
    with ThreadPoolExecutor(max_workers=4) as pool:
        assert all(result == written for result in pool.map(run, parallel, ["write"] * 4))
        assert all(result == served for result in pool.map(run, parallel, ["read"] * 4))
    # Each archive is one file, and reading or unwinding writes nothing.
    files = sorted(path.name for path in work.iterdir() if path.suffix != ".metal")
    assert files == sorted(name + ".mtl4a" for name in ["pipelines", *parallel]), files
    assert sentinel.read_text() == "foreign data"
    # Other applications can create directories concurrently. Only flag this fixture's pipelines.
    for directory in set(cache.iterdir()) - before:
        for descriptor in directory.glob("descriptor/*.airp"):
            try:
                leaked = b"CacheTest" in descriptor.read_bytes()
            except FileNotFoundError:
                continue
            if leaked:
                raise RuntimeError(f"Pipeline capture scratch survived teardown: {directory}")
print("Passed write, read, rewrite, unwind, concurrent capture and scratch ownership checks")
