#!/usr/bin/env python3
"""Check cold and warm Metal pipeline archives, concurrent capture and cleanup on exit."""

import argparse
from concurrent.futures import ThreadPoolExecutor
import json
from pathlib import Path
import subprocess
import tempfile

root = Path(__file__).resolve().parents[1]
cli = argparse.ArgumentParser(description=__doc__)
cli.add_argument("--app", type=Path, default=root / "build/MeshEditorPipelineCacheTest")
app = cli.parse_args().app.resolve()
cache = (
    Path(subprocess.check_output(["getconf", "DARWIN_USER_CACHE_DIR"], text=True).strip())
    / "com.apple.gpuarchiver"
)
cache.mkdir(exist_ok=True)
with tempfile.TemporaryDirectory() as scratch, tempfile.TemporaryDirectory(
    prefix="gpuarchiver-unrelated-", dir=cache
) as foreign:
    work = Path(scratch)
    (work / "CacheTest.metal").write_text(
        "#include <metal_stdlib>\nkernel void CacheTest(device float *p) { p[0] = 1; }\n"
        "kernel void CacheTestSecond(device float *p) { p[0] = 2; }\n"
    )
    sentinel = Path(foreign) / "keep"
    sentinel.write_text("foreign data")
    before = set(cache.iterdir())

    def run(archive, mode="normal"):
        result = subprocess.run(
            [app, work, work / (archive + ".mtl4a"), mode], check=True, stdout=subprocess.PIPE, text=True
        )
        return json.loads(result.stdout) if mode == "normal" else None

    assert run("pipelines") == {"hits": 0, "compiled": 2}
    assert run("pipelines") == {"hits": 2, "compiled": 0}
    run("unwind", "unwind")
    with ThreadPoolExecutor(max_workers=4) as pool:
        assert all(
            result == {"hits": 0, "compiled": 2}
            for result in pool.map(run, (f"parallel-{i}" for i in range(4)))
        )
    assert sentinel.read_text() == "foreign data"
    # Other applications can create directories concurrently. Only flag this fixture's pipelines.
    for directory in set(cache.iterdir()) - before:
        for descriptor in directory.glob("descriptor/*.airp"):
            try:
                leaked = b"CacheTest" in descriptor.read_bytes()
            except FileNotFoundError:
                continue
            if leaked:
                raise RuntimeError(f"Pipeline capture scratch survived teardown: {directory}")
print("Passed cold, warm, unwind, concurrent capture and scratch ownership checks")
