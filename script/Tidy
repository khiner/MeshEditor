#!/bin/bash

# Runs clang-tidy with the repository configuration over src/ or one supplied path.
#   script/Tidy
#   script/Tidy src/physics/PhysicsSystem.cpp
#   script/Tidy --fix [path]
# --fix applies the fixes and reformats the changed lines first, then reports what remains.
# Returns nonzero when findings remain.

set -uo pipefail

ScriptDir="$(cd "$(dirname "${0}")" && pwd)"
ProjectRootDir="$(dirname "${ScriptDir}")"

Fix=false
if [[ "${1:-}" == "--fix" ]]; then
    Fix=true
    shift
fi

Target="${1:-${ProjectRootDir}/src/}"

if [[ "${Fix}" == true ]]; then
    FixesDir="$(mktemp -d)"
    trap 'rm -rf "${FixesDir}"' EXIT
    # loop-convert names the variable after the container and spells out reference types.
    run-clang-tidy -p "${ProjectRootDir}/build" -quiet -checks=-modernize-loop-convert -export-fixes "${FixesDir}/fixes.yaml" "${Target}" >/dev/null 2>&1
    if [[ -f "${FixesDir}/fixes.yaml" ]]; then
        # Drop include insertions from the run-clang-tidy YAML.
        python3 - "${FixesDir}/fixes.yaml" <<'EOF'
import sys, yaml
path = sys.argv[1]
fixes = yaml.safe_load(open(path))
for diagnostic in fixes.get('Diagnostics') or []:
    message = diagnostic.get('DiagnosticMessage') or {}
    message['Replacements'] = [r for r in message.get('Replacements') or [] if not r['ReplacementText'].startswith('#include')]
yaml.safe_dump(fixes, open(path, 'w'))
EOF
        # -format also removes syntax left by fixes, such as a comma after a removed argument.
        clang-apply-replacements -format -style=file "${FixesDir}"
    fi
fi

Findings="$(
    run-clang-tidy -p "${ProjectRootDir}/build" -quiet "${Target}" 2>&1 |
        grep -oE "${ProjectRootDir}/src/[^ ]+: warning:.*\[[a-z-]+\]" | sort -u
)"

if [[ -n "${Findings}" ]]; then
    echo "${Findings}"
    echo "$(echo "${Findings}" | wc -l | tr -d ' ') finding(s)."
    exit 1
fi
echo "clang-tidy: clean."
