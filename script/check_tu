#!/bin/bash
# Syntax-check one translation unit with its current compile_commands.json flags.
set -e

cd "$(dirname "$0")/.."
Source="${1:?usage: $0 source-file [extra compiler flags...]}"
shift
ExtraArgs=()
for Arg in "$@"; do ExtraArgs+=(--extra-arg="${Arg}"); done
exec /opt/homebrew/opt/llvm/bin/clang-check "${Source}" -p build "${ExtraArgs[@]}"
