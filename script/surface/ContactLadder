#!/usr/bin/env python3

# Measures sustained-contact roughness and speed exponents from any working directory.
# Usage: script/surface/ContactLadder [grid|sweep|sphere|spectrum|gradient|damping|modes|rate]
# grid reports roughness exponents by speed and speed exponents by roughness over Dang 2013's operating range.
# sweep reports roughness exponents over four corpus speeds.
# sphere repeats the ladder with a load-defined point contact.
# spectrum compares Hertz and linear laws by band following Perret-Liaudet 2003 section 5.3.3.
# gradient varies length scale at constant surface gradient following Ben Abdelounis 2011 Eq. 8.
# damping tests the -10 dB level change per decade of modal damping from Perret-Liaudet 2003 Fig. 16 and Dang 2013.
# modes verifies spectral peaks at resonator eigenfrequencies following Dang 2013 Fig. 13 and Ben Abdelounis 2010.
# rate reports shock rate against sliding speed for acceptance invariant 1b.
# Dang reports roughness exponents of 0.63-0.67 and speed exponents of 0.52-0.63.
# Ben Abdelounis reports roughness exponents of 0.8-1.16 and speed exponents of 0.7-0.96.
# Report both exponent spreads because the level separates as Ra^n V^m.
# Verify that parameter changes survive float32 loading before interpreting identical deterministic output.
# Dang's roughness ladder uses three correlation lengths and therefore three surface realizations.
# Label each exponent by axis because the cited papers reverse the m and n symbols.
# Use one fixed lane size for all frictionless rungs to preserve geometry and prevent endpoint silence.
# Each scene contains one body because the mono mix cannot separate multiple bodies.
# Report the solved-bar pressure probe with every exponent.
# LADDER_T60, LADDER_HIGH, and LADDER_PRESSURE applied only to the retired synthetic probe.
# Constant zeta 0.02 measured roughness spread 0.322 versus 0.316 and speed spread 0.128 versus 0.108.
# Four LADDER_SEED realizations moved exponents by 0.049 and spreads by 0.055.
# Treat unpaired changes below approximately 0.04 per exponent or 0.05 per spread as surface variation.
# Increasing renders from 6 s to 24 s reduced a two-seed gap from 0.090 to 0.022.
# Re-run marginal 6 s results for at least 24 s and require consistent signs across realizations.

import math
import os
import subprocess
import sys
from pathlib import Path

Repo = Path(__file__).resolve().parent.parent.parent
Out = Path(os.environ.get("TMPDIR", "/tmp")) / "contact_ladder"
sys.path.insert(0, str(Repo / "glTF_PhysicalAudio/samples"))
import generate as gen

# A null change measured roughness spreads of 0.027 at 6 s and 0.012 at 24 s.
# The 12 s default estimates a spread floor of 0.017 under square-root averaging.
# Use LADDER_PLAY=6 for iteration and at least 24 s for marginal results.
Play = float(os.environ.get("LADDER_PLAY", "12.0"))
Settle = 2.0  # Seconds excluded from level measurement to remove the initial impact.
LaneHalf = 80.0  # Metres required to contain the fastest rung.
# Dang 2013 and Ben Abdelounis 2011 use zeta 0.02 for every mode.
# Zero preserves the solved bar's Rayleigh decay rates.
ProbeZeta = float(os.environ.get("LADDER_ZETA", "0"))
# The phase seed depends on correlation length, spectral slope, and sample spacing.
# A 1e-6 slope step exceeds float32 spacing near 2.4 and changes the realization without materially changing its spectrum.
LadderSeed = int(os.environ.get("LADDER_SEED", "0"))

# The solved bar spans 52.4 Hz to 7.6 kHz across 40 modes, comparable to Dang's 29 Hz to 10 kHz resonator.
RigBarHalf = (0.45, 0.03, 0.004)
SliderMass = 0.5  # kg


def ladder_probe(zeta=None):
    """Return the solved rig-bar probe with an optional constant damping ratio."""
    solved = dict(gen.solved_modes(RigBarHalf, gen.CERAMIC, modes=40))
    z = ProbeZeta if zeta is None else zeta
    if z > 0:
        solved["decayRates"] = [z * 2 * math.pi * f for f in solved["frequencies"]]
    return solved

# Dang 2013 Table 8 varies roughness over an elevenfold range while correlation length changes from 400 um to 500 um.
Profiles = [(3.57e-6, 400e-6), (6.02e-6, 450e-6), (11.88e-6, 500e-6), (25.80e-6, 500e-6), (38.61e-6, 500e-6)]
Speeds = [0.02, 0.04, 0.1, 0.2, 0.7]  # m/s from Dang's seven-speed range.
# Use LADDER_SPEEDS=0.1,0.14,0.2,0.28,0.4 to sample intermediate speeds.
if os.environ.get("LADDER_SPEEDS"):
    Speeds = [float(s) for s in os.environ["LADDER_SPEEDS"].split(",")]
DangRoughness = [0.63, 0.64, 0.66, 0.65, 0.67]  # his Fig. 15, one per speed
DangSpeed = [0.52, 0.63, 0.58, 0.55, 0.54]  # his Fig. 14, one per roughness


def build(name, roughness, correlation_length, speed, shape="box", zeta=None):
    """Build one frictionless sliding body using face contact for boxes and Hertz contact for spheres."""
    gen.OUT = Out
    # LADDER_WAVINESS=0 removes mesoscale variation and matches Dang's finish-only profiles.
    # A 2026-08-10 measurement over four 24 s seeds produced roughness exponents 0.32, 0.31, 0.69, and 0.69.
    waviness_scale = float(os.environ.get("LADDER_WAVINESS", "1"))
    surface = {"name": "Ladder", "material": 0, "roughness": roughness,
               "correlationLength": correlation_length,
               "spectralSlope": gen.FINISHES["Machined"]["spectralSlope"] * (1 + LadderSeed * 1e-6),
               "waviness": waviness_scale * roughness, "wavinessLength": 40 * correlation_length}
    gen.scene(
        name, "ladder rung",
        bodies=[gen.body("Slider", SliderMass, 1, 0, shape)],
        grounds=[gen.ground("Ladder", 0, 1)],
        surfaces=[surface],
        physics_materials=[{"staticFriction": 0.0, "dynamicFriction": 0.0, "restitution": 0.0}],
        probe=ladder_probe(zeta),
        speed=speed, lane_half=(LaneHalf, 0.04, 0.12), start_x=-0.9 * LaneHalf,
        bar_half=RigBarHalf,
    )
    return Out / f"{name}.gltf"


# A 2026-08-04 6 s grid measured 50 s at one job, 20 s at four, 17 s at eight, and 29 s at sixteen.
# One-job and eight-job renders produced bit-identical grids.
Jobs = int(os.environ.get("LADDER_JOBS", "8"))


def render_many(paths):
    """Render paths concurrently and return samples in input order."""
    from concurrent.futures import ThreadPoolExecutor
    with ThreadPoolExecutor(max_workers=Jobs) as pool:
        return list(pool.map(render, paths))


def decode(recording):
    """Decode a recording to mono float32 samples at 48 kHz."""
    p = subprocess.run(["ffmpeg", "-v", "error", "-i", str(recording), "-map", "0:a", "-f", "f32le",
                        "-ac", "1", "-ar", "48000", "-"], capture_output=True)
    if p.returncode != 0:
        raise RuntimeError(f"decode {recording.name} exited {p.returncode}")
    import array
    a = array.array("f")
    a.frombytes(p.stdout)
    return a


def render(path):
    """Render one rung headless and return its mono samples."""
    wav = path.with_suffix(".wav")
    wav.unlink(missing_ok=True)
    r = subprocess.run([str(Repo / "build/MeshEditor"), str(path), "--headless", "--play", str(Play),
                        "--timeline-end", str(Play + 1), "--record", str(wav)], capture_output=True)
    if r.returncode != 0:
        raise RuntimeError(f"render {path.name} exited {r.returncode}: {r.stderr[-400:]!r}")
    a = decode(wav)
    return a


def level(samples):
    """Return mean power after the initial-impact interval.

    Dang reports full-run time-averaged vibration level.
    A 2026-08-10 seed-zero grid measured exponent -0.44 with median frames and +0.33 with whole-window power.
    Measurements recorded before 2026-08-10 used median frame power and are not comparable."""
    start = int(Settle * 48000)
    if len(samples) <= start:
        return 0.0
    return sum(s * s for s in samples[start:]) / (len(samples) - start)


def exponent(xs, levels):
    """Least-squares slope of log(level) against log(x), halved because a level is a power."""
    pts = [(math.log(x), math.log(y)) for x, y in zip(xs, levels) if y > 0]
    if len(pts) < 2:
        return float("nan")
    mx = sum(p[0] for p in pts) / len(pts)
    my = sum(p[1] for p in pts) / len(pts)
    den = sum((p[0] - mx) ** 2 for p in pts)
    return sum((p[0] - mx) * (p[1] - my) for p in pts) / den / 2


def spread(values):
    return max(values) - min(values)


def grid():
    rungs = [(si, ri, build(f"g{si}_{ri}", rq, lc, v))
             for si, v in enumerate(Speeds) for ri, (rq, lc) in enumerate(Profiles)]
    levels = {(si, ri): level(s) for (si, ri, _), s in zip(rungs, render_many([r[2] for r in rungs]))}
    for si, v in enumerate(Speeds):
        print(f"  v={v}: " + " ".join(f"{levels[(si, ri)]:.3e}" for ri in range(len(Profiles))), flush=True)

    rq = [p[0] for p in Profiles]
    rough = [exponent(rq, [levels[(si, ri)] for ri in range(len(Profiles))]) for si in range(len(Speeds))]
    speed = [exponent(Speeds, [levels[(si, ri)] for si in range(len(Speeds))]) for ri in range(len(Profiles))]
    print("\nroughness exponent at each speed")
    for v, m, d in zip(Speeds, rough, DangRoughness):
        print(f"  v={v:<5} m/s   {m:+.3f}   (Dang {d})")
    print("speed exponent at each roughness")
    for (r, _), n, d in zip(Profiles, speed, DangSpeed):
        print(f"  Rq={r * 1e6:<5.1f} um  {n:+.3f}   (Dang {d})")
    print(f"\nSPREAD roughness {spread(rough):.3f} (Dang {spread(DangRoughness):.2f})"
          f"  speed {spread(speed):.3f} (Dang {spread(DangSpeed):.2f})")


def sweep():
    """Report the roughness exponent at four sliding speeds."""
    rq = [p[0] for p in Profiles]
    speeds = (0.02, 0.1, 0.4, 1.4)
    samples = render_many([build(f"s{v}_{ri}", r, lc, v) for v in speeds for ri, (r, lc) in enumerate(Profiles)])
    for i, v in enumerate(speeds):
        levels = [level(s) for s in samples[i * len(Profiles):(i + 1) * len(Profiles)]]
        print(f"  v={v:<5} m/s   roughness exponent {exponent(rq, levels):+.3f}", flush=True)


def gradient():
    """Report levels while varying length scale at a fixed roughness-to-spacing ratio of 0.04.

    Ben Abdelounis 2011 Eq. 8 predicts equal levels from the fixed ratio, but the source data does not vary scale independently.
    A 2026-08-03 measurement found spreads of 6.0 dB at 0.1 m/s and 15.8 dB at 0.7 m/s.
    Extending the probe from 7 kHz to 20 kHz produced spreads of 6.0 dB and 15.8 dB instead of 6.6 dB and 15.6 dB."""
    scales = [1e-3, 2e-4, 5e-5]  # correlation length, m
    speeds = (0.1, 0.7)
    samples = render_many([build(f"q{v}_{i}", 0.04 * lc, lc, v) for v in speeds for i, lc in enumerate(scales)])
    for si, v in enumerate(speeds):
        levels = [level(s) for s in samples[si * len(scales):(si + 1) * len(scales)]]
        ratio = max(levels) / min(levels) if min(levels) > 0 else float("inf")
        print(f"  v={v:<5} m/s   levels " + " ".join(f"{x:.3e}" for x in levels)
              + f"   spread {10 * math.log10(ratio):.1f} dB", flush=True)


def spectrum():
    """Report octave-band power for the current Hertz contact.

    Perret-Liaudet and Rigaud 2003 section 5.3.3 compares Hertz and linear laws under the same contact-loss clamp.
    The linear-law arm was removed with the previous engine on 2026-08-08.
    A 2026-08-03 Hertz-minus-linear measurement produced these dB differences by octave band:
      v=0.7 m/s  125-250 -0.15, 250-500 -0.07, 500-1k +0.69, 1k-2k -0.05, 2k-4k +0.42, 4k-8k -0.59
      v=0.1 m/s  125-250 -0.87, 250-500 -0.14, 500-1k +0.25, 1k-2k +1.18, 2k-4k +1.66, 4k-8k +2.94
    The 4-8 kHz band was approximately 19 dB below the dominant band.
    Repeated unchanged runs were bit-identical on 2026-08-04."""
    import numpy as np
    for v in (0.1, 0.7):
        samples = np.asarray(render(build(f"sp{v}", 6.02e-6, 4.5e-4, v)), dtype=np.float64)
        samples = samples[int(Settle * 48000):]
        n = 1 << 14
        trimmed = samples[:len(samples) // n * n].reshape(-1, n)
        psd = (np.abs(np.fft.rfft(trimmed * np.hanning(n), axis=1)) ** 2).mean(axis=0)
        freq = np.fft.rfftfreq(n, 1 / 48000)
        print(f"  v={v} m/s", flush=True)
        for lo in (125, 250, 500, 1000, 2000, 4000, 8000):
            band = (freq >= lo) & (freq < 2 * lo)
            print(f"    {lo:>5}-{2 * lo:<5} Hz  {10 * math.log10(psd[band].sum() + 1e-300):8.2f} dB", flush=True)


def rate():
    """Report shock rate, flight fraction, bearing fraction, level, and intensity against speed.

    CONTACT_REPORT counts each cell that resumes bearing load as one shock.
    Ben Abdelounis 2011 Figs. 6 and 7 report decreasing shock rate as speed increases and the body loses contact.
    The offline sweep rate equals speed divided by correlation length because it has no moving body.
    A 2026-08-04 measurement at Rq 6.02 um produced:

        speed   shocks/s   free    bearing   level       intensity
        0.02    1718       0.121   0.098     1.459e-14   8.493e-18
        0.04    2124       0.450   0.064     4.508e-14   2.123e-17
        0.1     1984       0.736   0.036     1.358e-13   6.848e-17
        0.2     4739       0.635   0.055     1.058e-13   2.233e-17
        0.7     4887       0.846   0.029     2.037e-13   4.170e-17

    Rate +0.323 and intensity +0.364 sum to the level slope +0.687.
    Across Dang's five speeds, the amplitude-rate exponent is 0.647 and satisfies acceptance invariant 1b.
    Intermediate speeds separate two regimes:

        speed   0.1    0.14   0.2    0.28   0.4    0.55   0.7
        rate    1984   3718   4739   4361   4328   4463   4887
        free    0.736  0.647  0.635  0.734  0.794  0.833  0.846

        0.10 to 0.20 m/s : rate ~ v^+1.25, superlinear
        0.20 to 0.70 m/s : rate ~ v^+0.02, flat

    Report the regime with its exponent because the aggregate 0.647 exponent spans both behaviors.
    The reported rate is per cell at 48 kHz and supports scaling comparisons only."""
    print(f"  {'speed':>6} {'shocks/s':>12} {'free':>8} {'bearing':>8} {'level':>12} {'intensity':>12}")
    rows = []
    for v in Speeds:
        path = build(f"rt{v}", 6.02e-6, 4.5e-4, v)
        wav = path.with_suffix(".wav")
        wav.unlink(missing_ok=True)
        log = Out / f"rt{v}.err"
        with open(log, "w") as err:
            # Use a file because the reporting channel is unavailable through a pipe.
            subprocess.run([str(Repo / "build/MeshEditor"), str(path), "--headless", "--play", str(Play),
                            "--timeline-end", str(Play + 1), "--record", str(wav)],
                           stdout=subprocess.DEVNULL, stderr=err, env={**os.environ, "CONTACT_REPORT": "1"})
        line = next((l for l in reversed(log.read_text().splitlines()) if l.startswith("CONTACT ")), None)
        if line is None:
            print(f"  {v:>6} no report")
            continue
        f = dict(p.split("=", 1) for p in line.split()[1:] if "=" in p)
        # Ben Abdelounis 2011 defines intensity as level divided by rate.
        lvl = level(decode(wav))
        rate_v = float(f["rate"])
        rows.append((v, rate_v, float(f["free"]), float(f["bearing"]), lvl, lvl / rate_v if rate_v > 0 else 0.0))
        print(f"  {v:>6} {rows[-1][1]:>12.4g} {rows[-1][2]:>8.4f} {rows[-1][3]:>8.4f}"
              f" {lvl:>12.4g} {rows[-1][5]:>12.4g}", flush=True)
    if len(rows) > 1:
        speeds = [r[0] for r in rows]
        # Convert the amplitude exponent to a power exponent.
        rate_slope = 2 * exponent(speeds, [r[1] for r in rows])
        intensity_slope = 2 * exponent(speeds, [r[5] for r in rows])
        level_slope = 2 * exponent(speeds, [r[4] for r in rows])
        print(f"\n  rate      goes as speed^{rate_slope:+.3f}   (bodyless sweep gives +1.000 by construction,"
              f" Ben Abdelounis measures it NEGATIVE)")
        print(f"  intensity goes as speed^{intensity_slope:+.3f}   (Ben Abdelounis measures it POSITIVE)")
        # Dang tabulates amplitude exponents, equal to half these power exponents.
        print(f"  level     goes as speed^{level_slope:+.3f}   = their sum. As an amplitude, which is the"
              f" convention Dang and Ben Abdelounis tabulate, that is {level_slope / 2:+.3f}.")


def modes():
    """Compare rendered spectral peaks with retuned resonator eigenfrequencies.

    Dang 2013 Fig. 13 and Ben Abdelounis et al. 2010 report spectral peaks at resonator eigenfrequencies.
    Peak search uses log-power parabolic interpolation within 2 percent of each mode.
    Slider scaling shifts the reference frequencies by 1/s, including a 490-cent shift for the 0.5 kg rig.
    A 2026-08-05 measurement produced these offsets:

        v=0.1 Rq=6.0 um   median 2.7   worst -35.0   within one bin 13/39
        v=0.7 Rq=6.0 um   median 1.6   worst -34.5   within one bin 12/39
        v=0.7 Rq=38.6 um  median 0.9   worst +34.7   within one bin 20/39
    The analysis bin width is 1.46 Hz, and 17 cents is approximately 1 percent.
    The control varies Rq from 6.0 um to 38.6 um because contact-stiffness detuning should increase with roughness."""
    import numpy as np
    solved = ladder_probe()
    # Apply the same mass-based frequency scaling as the renderer.
    slider_scale = (SliderMass / solved["mass"]) ** (1.0 / 3.0)
    freqs = [f / slider_scale for f in solved["frequencies"]]
    for v, rq in ((0.1, 6.02e-6), (0.7, 6.02e-6), (0.7, 38.61e-6)):
        samples = np.asarray(render(build(f"md{v}_{rq:.0e}", rq, 4.5e-4, v)), dtype=np.float64)
        samples = samples[int(Settle * 48000):]
        n = 1 << 15
        trimmed = samples[:len(samples) // n * n].reshape(-1, n)
        psd = (np.abs(np.fft.rfft(trimmed * np.hanning(n), axis=1)) ** 2).mean(axis=0)
        freq = np.fft.rfftfreq(n, 1 / 48000)
        bin_hz = 48000 / n
        offsets = []
        for f0 in freqs:
            band = np.flatnonzero((freq >= f0 * 0.98) & (freq <= f0 * 1.02))
            if len(band) < 3:
                continue
            i = band[int(np.argmax(psd[band]))]
            if i == 0 or i + 1 >= len(psd) or psd[i] <= 0:
                continue
            # Interpolate the peak from three log-power bins.
            y0, y1, y2 = (math.log(max(psd[j], 1e-300)) for j in (i - 1, i, i + 1))
            denom = y0 - 2 * y1 + y2
            delta = 0.5 * (y0 - y2) / denom if denom != 0 else 0.0
            f_peak = freq[i] + max(min(delta, 1.0), -1.0) * bin_hz
            offsets.append(1200 * math.log2(f_peak / f0))
        # Use the median to limit unresolved low-frequency bins and weakly driven modes.
        ranked = sorted(abs(o) for o in offsets)
        median = ranked[len(ranked) // 2]
        within = sum(1 for f0, o in zip(freqs, offsets) if abs(o) <= 1200 * math.log2((f0 + bin_hz) / f0))
        print(f"  v={v:<5} Rq={rq * 1e6:<5.1f} um  median {median:5.1f} cents  worst {max(offsets, key=abs):+7.1f}  "
              f"within one bin {within}/{len(offsets)}  (bin {bin_hz:.2f} Hz, 17 cents = 1%)", flush=True)


def damping():
    """Fit power level against modal damping ratio at a fixed operating point.

    Perret-Liaudet and Rigaud 2003 Fig. 16 and Dang 2013 report -10 dB per damping decade.
    The energy-balance prediction is power proportional to zeta^-1.
    Measured slopes were -0.81 at 0.1 m/s and -0.78 at 0.7 m/s.
    At zeta 0.005, the lowest mode has a 1.2 s T60 compared with the 0.1 s analysis frame."""
    rq, lc = Profiles[1] # Dang's second profile, mid-ladder
    zetas = [0.005, 0.02, 0.08, 0.32] # a 64x span, four rungs of nothing else changing
    speeds = (0.1, 0.7)
    samples = render_many([build(f"d{v}_{i}", rq, lc, v, zeta=z) for v in speeds for i, z in enumerate(zetas)])
    for si, v in enumerate(speeds):
        levels = [level(s) for s in samples[si * len(zetas):(si + 1) * len(zetas)]]
        # Convert the amplitude exponent to the power exponent predicted as -1.
        slope = 2 * exponent(zetas, levels)
        rel = " ".join(f"{10 * math.log10(x / levels[0]):+.1f}" for x in levels)
        print(f"  v={v:<5} m/s   slope {slope:+.3f} /decade (energy balance -1.000)   dB re first: {rel}", flush=True)


def sphere():
    """Report the roughness exponent for a load-defined spherical point contact."""
    rq = [p[0] for p in Profiles]
    speeds = (0.02, 0.1, 0.7)
    samples = render_many([build(f"p{v}_{ri}", r, lc, v, "sphere")
                           for v in speeds for ri, (r, lc) in enumerate(Profiles)])
    for i, v in enumerate(speeds):
        levels = [level(s) for s in samples[i * len(Profiles):(i + 1) * len(Profiles)]]
        print(f"  v={v:<5} m/s   roughness exponent {exponent(rq, levels):+.3f}"
              f"   levels " + " ".join(f"{x:.2e}" for x in levels), flush=True)


if __name__ == "__main__":
    Modes = {"grid": grid, "sweep": sweep, "sphere": sphere, "gradient": gradient, "spectrum": spectrum, "damping": damping, "modes": modes, "rate": rate}
    mode = sys.argv[1] if len(sys.argv) > 1 else "grid"
    if mode not in Modes:
        sys.exit(f"Unknown mode '{mode}'. Modes: {', '.join(Modes)}")
    Out.mkdir(parents=True, exist_ok=True)
    Modes[mode]()
