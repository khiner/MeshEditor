#!/usr/bin/env python3
# (Re-)generate the committed `render/` corpus. See the "Render corpus" section in README.md for what each
# scene's leaf contains. Covers Empty, Default, res/examples, the full-experience audio scenes at the root of
# glTF_PhysicalAudio/samples/, and all glTF samples under external/. Run from anywhere.
# Scenes render headless in a pool of persistent worker processes that pull from a shared job spool
# (`--render-queue`), clearing the scene between jobs. `--out` renders into a side directory and `--app-args`
# hands every worker extra app flags, producing a candidate tree for script/CompareRenders to judge.
# JOBS sets the worker count. COMPARE_VIDEOS=1 restores videos that differ from HEAD only by GPU render noise.
from __future__ import annotations

import argparse
import os
from pathlib import Path
import queue
import shlex
import shutil
import subprocess
import sys
import tempfile
import threading

ScriptDir = Path(__file__).resolve().parent
CorpusDir = Path("render")
Exe = "./build/MeshEditor"
SceneTimeoutSecs = 120  # Catches hangs. Renders are GPU-paced, not real-time, and parallel renders contend for the GPU.
GltfRoots = [Path("external/glTF-Sample-Assets"), Path("external/glTF_Physics")]
# glTF_Physics/tests/ are conformance unit tests that render empty or hang the physics solver. Every model in
# a glTF-Binary or glTF-Embedded dir also ships a glTF variant that renders identically.
ExcludedDirs = ("/glTF_Physics/tests/", "/glTF-Binary/", "/glTF-Embedded/")

# A scene is its output basename under the render dir (no extension) and the app arg selecting it:
# a scene file, "--empty", or empty for the default scene.
Scene = tuple[Path, str]


def has_output(out: Path) -> bool:
    return Path(f"{out}.webp").is_file() or Path(f"{out}.mp4").is_file()


def scene_files(root: Path) -> list[Path]:
    return sorted(
        Path(d) / f for d, _, files in os.walk(root) if not any(x in f"/{d}/" for x in ExcludedDirs)
        for f in files if f.lower().endswith((".gltf", ".glb"))
    )


def discover_scenes() -> list[Scene]:
    scenes = [(Path("Empty/Empty"), "--empty"), (Path("Default/Default"), "")]
    # The isolation corpus under samples/test/ is measured by script/AudioCorpus, so only the root scenes render.
    scenes += [(p.with_suffix(""), str(p)) for p in sorted(Path("glTF_PhysicalAudio/samples").glob("*.gltf"))]
    files = scene_files(Path("res/examples"))
    for root in GltfRoots:
        if found := scene_files(root): files += found
        else: print(f"WARNING: '{root}' has no glTF samples (run: git submodule update --init {root}). Skipping it.", file=sys.stderr)
    # A model shipping both .gltf and .glb in one directory is one scene, rendered once.
    by_out = {}
    for p in sorted(files): by_out.setdefault(p.with_suffix(""), p)
    return scenes + [(out, str(p)) for out, p in by_out.items()]


def prepare_leaf(out: Path, arg: str, extra_args: list[str]) -> None:
    """Clear the leaf of prior artifacts and write its one-command reproducer, which loads the source scene directly."""
    out.parent.mkdir(parents=True, exist_ok=True)
    for f in out.parent.iterdir():
        if f.name != "run.sh": f.unlink()
    run_sh = out.parent / "run.sh"
    run_sh.write_text(f"#!/bin/bash\n# Load this scene in the app. Run from the repository root.\nexec {shlex.join([Exe, *([arg] if arg else []), *extra_args])}\n")
    run_sh.chmod(run_sh.stat().st_mode | 0o111)


def committed_bytes(render_dir: Path, out: Path) -> int:
    """Size of the scene's committed artifacts, estimating its render cost."""
    committed = CorpusDir / out.relative_to(render_dir)
    return sum(f.stat().st_size for e in (".mp4", ".webp", ".png") if (f := Path(f"{committed}{e}")).is_file())


def spool_jobs(spool: Path, scenes: list[Scene]) -> None:
    for i, (out, arg) in enumerate(scenes): (spool / f"{i:04d}.job").write_text(f"{out}\t{arg}\n")


def count_jobs(spool: Path) -> int:
    return sum(1 for _ in spool.glob("*.job"))


def run_worker(spool: Path, extra_args: list[str], skipped: set[str]) -> None:
    """Run the app on the spool until it drains, killing and respawning it when a scene hangs.
    `skipped` collects the scenes the app reports finishing without output."""
    while (remaining := count_jobs(spool)) > 0:
        proc = subprocess.Popen([Exe, "--render-queue", str(spool), "-q", *extra_args], stdout=subprocess.PIPE, text=True)
        lines: queue.Queue[str | None] = queue.Queue()
        threading.Thread(target=lambda: ([lines.put(l.rstrip("\n")) for l in proc.stdout], lines.put(None)), daemon=True).start()
        while True:
            try: line = lines.get(timeout=SceneTimeoutSecs)
            except queue.Empty:
                proc.kill()
                break
            if line is None: break
            print(f"  {line}")
            if line.startswith("SKIP "): skipped.add(line[len("SKIP "):].split(" (", 1)[0])
        proc.wait()
        # An exit that claimed no job means the app can't start, so don't respawn into a crash loop.
        if count_jobs(spool) == remaining: break


def restore_noise_only_videos(spool: Path) -> None:
    """Restore committed videos that differ only by GPU render noise (see script/VideosEquivalent)."""
    changed = subprocess.run(["git", "diff", "--name-only", "--", str(CorpusDir)], capture_output=True, text=True).stdout.splitlines()
    for f in (f for f in changed if f.endswith(".mp4")):
        blob = subprocess.run(["git", "cat-file", "--filters", f"HEAD:{f}"], capture_output=True)
        if blob.returncode: continue
        committed = spool / "committed.mp4"
        committed.write_bytes(blob.stdout)
        result = subprocess.run([ScriptDir / "VideosEquivalent", committed, f], stdout=subprocess.PIPE, text=True)
        stats = result.stdout.rstrip("\n").replace("\n", "; ")
        if result.returncode == 0:
            subprocess.run(["git", "checkout", "--", f])
            print(f"Render noise only ({stats}): restored {f}")
        else:
            print(f"Content changed ({stats}): {f}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Rebuild MeshEditor and regenerate the render corpus.",
        epilog="environment:\n  JOBS=N            headless render workers (default: 8)\n  COMPARE_VIDEOS=1  restore videos that differ from HEAD only by render noise",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--out", metavar="DIR", help="render into DIR instead of render/, leaving the committed corpus alone")
    parser.add_argument("--app-args", metavar="FLAGS", default="", help="extra MeshEditor flags for every render worker (word split on spaces)")
    args = parser.parse_args()
    render_dir = Path(args.out) if args.out else CorpusDir
    extra_args = args.app_args.split()
    jobs = int(os.environ.get("JOBS", "8"))

    sys.stdout.reconfigure(line_buffering=True)
    os.chdir(ScriptDir.parent)
    if status := subprocess.run([ScriptDir / "Build"]).returncode: sys.exit(status)

    scenes = [(render_dir / out, arg) for out, arg in discover_scenes()]
    # Expensive scenes first, so the longest renders overlap the rest of the queue. Measured before the leaves clear.
    scenes.sort(key=lambda s: committed_bytes(render_dir, s[0]), reverse=True)
    for out, arg in scenes: prepare_leaf(out, arg, extra_args)
    print(f"Rendering corpus into {render_dir}/ ({len(scenes)} scenes, {jobs} headless workers)...")
    spool = Path(tempfile.mkdtemp(prefix="MeshEditorRenderSpool."))
    try:
        spool_jobs(spool, scenes)
        skipped: set[str] = set()
        workers = [threading.Thread(target=run_worker, args=(spool, extra_args, skipped)) for _ in range(jobs)]
        for w in workers: w.start()
        for w in workers: w.join()

        # A scene no worker reported was lost to a crash (Metal device-loss) or a hang kill, so retry it once.
        if retries := [(out, arg) for out, arg in scenes if not has_output(out) and str(out) not in skipped]:
            for f in spool.iterdir(): f.unlink()
            for out, _ in retries: print(f"  retrying {out}")
            spool_jobs(spool, retries)
            run_worker(spool, extra_args, skipped)

        if os.environ.get("COMPARE_VIDEOS") and render_dir == CorpusDir: restore_noise_only_videos(spool)
    finally:
        shutil.rmtree(spool, ignore_errors=True)

    skips = [out for out, _ in scenes if not has_output(out)]
    print(f"\nDone: {len(scenes) - len(skips)} rendered, {len(skips)} skipped.")
    if skips: print("Skipped:\n" + "\n".join(f"  {out}" for out in skips))


if __name__ == "__main__":
    main()
