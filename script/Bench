#!/usr/bin/env python3

"""Run and compare MeshEditor renderer benchmarks."""

from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path
import platform
import shlex
import statistics
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
DEFAULT_SCENES = ROOT / "res" / "benchmarks"
DEFAULT_EXE = ROOT / "build" / "MeshEditor"
METRICS = (
    ("cpuMs", "ProcessEvents", "CPU update", 1.0),
    ("cpuMs", "RecordRenderCommandBuffer", "CPU record", 1.0),
    ("gpuMs", "Submit", "GPU", 1.0),
    ("counters", "DeviceAllocatedBytes", "memory MiB", 1 / (1024 * 1024)),
)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def json_hash(value: object) -> str:
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def files_hash(paths, root: Path) -> str:
    digest = hashlib.sha256()
    for path in paths:
        digest.update(str(path.relative_to(root)).encode())
        digest.update(bytes.fromhex(sha256(path)))
    return digest.hexdigest()


def dataset_hash(manifest: dict, scene_root: Path) -> str:
    directories = sorted({scene_root / Path(scene["path"]).parent for scene in manifest["scenes"]})
    return files_hash((path for directory in directories for path in sorted(directory.iterdir()) if path.is_file()), scene_root)


def scene_hash(scene: Path) -> str:
    return files_hash((path for path in sorted(scene.parent.iterdir()) if path.is_file()), scene.parent)


def command_output(*command: str) -> str:
    result = subprocess.run(command, cwd=ROOT, capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else ""


def source_state() -> dict:
    digest = hashlib.sha256()
    digest.update(
        subprocess.run(
            ("git", "diff", "--binary", "HEAD"),
            cwd=ROOT,
            check=True,
            capture_output=True,
        ).stdout
    )
    untracked = command_output("git", "ls-files", "--others", "--exclude-standard").splitlines()
    for name in sorted(untracked):
        path = ROOT / name
        digest.update(name.encode())
        if path.is_file():
            digest.update(path.read_bytes())
    return {
        "commit": command_output("git", "rev-parse", "HEAD"),
        "dirty": bool(command_output("git", "status", "--porcelain")),
        "diffHash": digest.hexdigest(),
    }


def sysctl(name: str) -> str | None:
    value = command_output("sysctl", "-n", name)
    return value or None


def host_info() -> dict:
    host = {
        "system": platform.system(),
        "release": platform.release(),
        "machine": platform.machine(),
    }
    if platform.system() == "Darwin":
        memory = sysctl("hw.memsize")
        host.update(
            {
                "model": sysctl("hw.model"),
                "chip": sysctl("machdep.cpu.brand_string"),
                "memoryBytes": int(memory) if memory else None,
            }
        )
    return host


def build_info() -> dict:
    cache = ROOT / "build" / "CMakeCache.txt"
    values: dict[str, object] = {}
    if cache.is_file():
        line = next((line for line in cache.read_text(errors="replace").splitlines() if line.startswith("CMAKE_BUILD_TYPE:")), None)
        if line:
            values["type"] = line.split("=", 1)[1]
    commands = ROOT / "build" / "compile_commands.json"
    if commands.is_file():
        entry = next(
            (item for item in json.loads(commands.read_text()) if item["file"].endswith("/src/main.cpp")),
            None,
        )
        if entry:
            arguments = entry.get("arguments") or shlex.split(entry["command"])
            values.update(
                {
                    "compiler": arguments[0],
                    "optimization": next((arg for arg in reversed(arguments) if arg.startswith("-O")), None),
                    "debugInfo": "-g" in arguments,
                    "architecture": next(
                        (arguments[i + 1] for i, arg in enumerate(arguments[:-1]) if arg == "-arch"),
                        None,
                    ),
                }
            )
    return values


def load_manifest(scene_root: Path) -> dict:
    path = scene_root / "benchmark.json"
    if not path.is_file():
        hint = " Run script/GenerateRenderBenchmarks first." if scene_root == DEFAULT_SCENES else ""
        raise SystemExit(f"No benchmark manifest at {path}.{hint}")
    manifest = json.loads(path.read_text())
    if manifest.get("schemaVersion") != 2 or not isinstance(manifest.get("cases"), list):
        raise SystemExit(f"Unsupported benchmark manifest at {path}; regenerate it")
    scene_names = {scene["name"] for scene in manifest["scenes"]}
    ids = [case["id"] for case in manifest["cases"]]
    if len(ids) != len(set(ids)):
        raise SystemExit("Benchmark case IDs are not unique")
    missing = [case["id"] for case in manifest["cases"] if case["scene"] not in scene_names]
    if missing:
        raise SystemExit("Benchmark cases reference missing scenes: " + ", ".join(missing))
    return manifest


def app_command(
    case: dict,
    scenes: dict[str, Path],
    exe: Path,
    frames: int,
    profile: Path | None,
    image: Path | None,
) -> list[str]:
    scene = Path(case["scenePath"]) if "scenePath" in case else scenes[case["scene"]]
    command = [
        str(exe),
        str(scene),
        "--headless",
        "--frames",
        str(frames),
        "--profile",
        "--quiet",
    ]
    command.extend(("--shading", case.get("shading", "solid")))
    command.extend(flag for key, flag in (("overlays", "--overlays"), ("selectAll", "--select-all")) if case.get(key))
    if edit := case.get("edit"):
        command.extend(("--edit", edit))
    action = case.get("action", "steady")
    if action == "playback":
        command.append("--play")
    else:
        command.extend(("--bench-action", action))
    for key, flag in (("camera", "--camera"), ("actionCount", "--bench-action-count"), ("motionBlur", "--motion-blur")):
        if value := case.get(key):
            command.extend((flag, str(value)))
    for value, flag in ((profile, "--profile-json"), (image, "--screenshot")):
        if value is not None:
            command.extend((flag, str(value)))
    return command


def run_process(command: list[str], log: Path) -> None:
    with log.open("w") as output:
        result = subprocess.run(command, cwd=ROOT, stdout=output, stderr=subprocess.STDOUT)
    if result.returncode == 0:
        return
    tail = "\n".join(log.read_text(errors="replace").splitlines()[-30:])
    raise SystemExit(f"Benchmark command failed ({result.returncode}):\n{' '.join(command)}\n{tail}")


def stat_value(profile: dict, section: str, name: str, field: str = "median") -> float | None:
    entry = next((entry for entry in profile.get(section, []) if entry["name"] == name), None)
    return float(entry[field]) if entry else None


def repetition_median(case: dict, section: str, name: str) -> float | None:
    values = [value for repetition in case["repetitions"] if (value := stat_value(repetition, section, name)) is not None]
    return statistics.median(values) if values else None


def number(value: float | None) -> str:
    return "-" if value is None else f"{value:.3f}"


def print_run_summary(result: dict) -> None:
    print(f"\n{'case':30} {'CPU update':>10} {'CPU record':>10} {'GPU ms':>10} {'memory MiB':>11}")
    for case in result["cases"]:
        values = [repetition_median(case, section, name) for section, name, _, _ in METRICS]
        scaled = [value * metric[3] if value is not None else None for value, metric in zip(values, METRICS)]
        print(f"{case['id']:30} {number(scaled[0]):>10} {number(scaled[1]):>10} {number(scaled[2]):>10} {number(scaled[3]):>11}")


def run(args: argparse.Namespace) -> None:
    scene_root = args.scene_root.resolve()
    manifest = load_manifest(scene_root)
    paths = {scene["name"]: scene_root / scene["path"] for scene in manifest["scenes"]}
    if args.scene and args.cases:
        raise SystemExit("--scene cannot be combined with manifest case IDs")
    if args.scene:
        scene = args.scene.resolve()
        if not scene.is_file():
            raise SystemExit(f"No such scene: {scene}")
        content_hash = scene_hash(scene)
        cases = [
            {
                "id": args.id or scene.stem,
                "scenePath": str(scene),
                "camera": args.camera,
                "shading": args.shading,
                "action": args.action,
                "actionCount": args.action_count,
                "overlays": args.overlays,
                "edit": args.edit,
                "selectAll": args.select_all,
                "motionBlur": args.motion_blur,
            }
        ]
    else:
        content_hash = dataset_hash(manifest, scene_root)
        wanted = set(args.cases)
        cases = [case for case in manifest["cases"] if not wanted or case["id"] in wanted]
        unknown = wanted - {case["id"] for case in cases}
        if unknown:
            raise SystemExit("Unknown benchmark cases: " + ", ".join(sorted(unknown)))
    if args.frames <= 0 or args.warmup_frames <= 0 or args.reps <= 0 or args.action_count <= 0:
        raise SystemExit("--frames, --warmup-frames, --reps, and --action-count must be positive")
    if args.motion_blur is not None and args.motion_blur <= 0:
        raise SystemExit("--motion-blur must be positive")
    exe = args.exe.resolve()
    if not args.no_build:
        subprocess.run((str(ROOT / "script" / "Build"), "--release"), cwd=ROOT, check=True)
    if not exe.is_file():
        raise SystemExit(f"No executable at {exe}")

    timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    output = args.output.resolve() if args.output else ROOT / "benchmark_results" / f"render-{timestamp}.json"
    output.parent.mkdir(parents=True, exist_ok=True)
    artifact_dir = output.with_suffix("")
    if not args.no_images:
        artifact_dir.mkdir(parents=True, exist_ok=True)
    repetitions = {case["id"]: [] for case in cases}
    images: dict[str, dict] = {}

    with tempfile.TemporaryDirectory(prefix="MeshEditorBench.") as temporary:
        temp = Path(temporary)
        for index, case in enumerate(cases):
            print(f"warm-up {case['id']}", flush=True)
            run_process(
                app_command(case, paths, exe, args.warmup_frames, None, None),
                temp / f"warmup-{index}.log",
            )
        for rep in range(args.reps):
            shift = rep % len(cases)
            order = cases[shift:] + cases[:shift]
            if rep % 2:
                order.reverse()
            for case in order:
                profile = temp / f"{case['id']}-{rep}.json"
                image = artifact_dir / f"{case['id']}.webp" if rep == 0 and not args.no_images else None
                print(f"run {rep + 1}/{args.reps} {case['id']}", flush=True)
                run_process(
                    app_command(case, paths, exe, args.frames, profile, image),
                    temp / f"{case['id']}-{rep}.log",
                )
                repetitions[case["id"]].append(json.loads(profile.read_text()))
                if image and not image.is_file():
                    raise SystemExit(f"Benchmark produced no validation image: {image}")
                if image:
                    images[case["id"]] = {
                        "path": str(image.relative_to(output.parent)),
                        "sha256": sha256(image),
                    }

    result_cases = [
        {**case, "repetitions": repetitions[case["id"]], **({"image": images[case["id"]]} if case["id"] in images else {})}
        for case in cases
    ]
    result = {
        "schemaVersion": 2,
        "createdUtc": timestamp,
        "source": source_state(),
        "binarySha256": sha256(exe),
        "build": build_info(),
        "host": host_info(),
        "frames": args.frames,
        "warmupFrames": args.warmup_frames,
        "repetitions": args.reps,
        "sceneRoot": str(scene_root),
        "manifestHash": json_hash(manifest),
        "datasetHash": content_hash,
        "sceneManifest": manifest,
        "cases": result_cases,
    }
    output.write_text(json.dumps(result, indent=2) + "\n")
    print_run_summary(result)
    print(f"\n{output}")


def metric_samples(case: dict, section: str, name: str) -> list[float]:
    return [value for repetition in case["repetitions"] if (value := stat_value(repetition, section, name)) is not None]


def metric_change(before: dict, after: dict, section: str, name: str) -> tuple[float, float, float, str] | None:
    a, b = metric_samples(before, section, name), metric_samples(after, section, name)
    if not a or not b:
        return None
    am, bm = statistics.median(a), statistics.median(b)
    change = 100 * (bm - am) / am if am else 0.0

    def noise(values: list[float], median: float) -> float:
        return 100 * 1.4826 * statistics.median(abs(value - median) for value in values) / median if median else 0.0

    threshold = max(1.0, 2 * max(noise(a, am), noise(b, bm)))
    status = "inconclusive" if abs(change) <= threshold else "better" if change < 0 else "worse"
    return am, bm, change, status


def case_settings(case: dict) -> dict:
    return {key: value for key, value in case.items() if key not in ("repetitions", "image")}


def compare(args: argparse.Namespace) -> None:
    before = json.loads(args.before.read_text())
    after = json.loads(args.after.read_text())
    for field in ("schemaVersion", "frames", "warmupFrames", "manifestHash", "datasetHash"):
        if before.get(field) != after.get(field):
            raise SystemExit(f"Cannot compare: {field} differs")
    for field in ("system", "release", "machine", "model", "chip"):
        if before.get("host", {}).get(field) != after.get("host", {}).get(field):
            raise SystemExit(f"Cannot compare: host {field} differs")
    if before.get("build") != after.get("build"):
        raise SystemExit("Cannot compare: build settings differ")
    before_cases = {case["id"]: case for case in before["cases"]}
    after_cases = {case["id"]: case for case in after["cases"]}
    if before_cases.keys() != after_cases.keys():
        raise SystemExit("Cannot compare: benchmark cases differ")
    if any(case_settings(before_cases[case_id]) != case_settings(after_cases[case_id]) for case_id in before_cases):
        raise SystemExit("Cannot compare: benchmark case settings differ")

    print(f"{'case':30} {'metric':12} {'before':>10} {'after':>10} {'change':>9}  result")
    for case_id in before_cases:
        for section, name, label, scale in METRICS:
            change = metric_change(before_cases[case_id], after_cases[case_id], section, name)
            if not change:
                continue
            old, new, percent, status = change
            print(f"{case_id:30} {label:12} {old * scale:10.3f} {new * scale:10.3f} {percent:+8.1f}%  {status}")

    changed_images = [case_id for case_id in before_cases if before_cases[case_id].get("image", {}).get("sha256") != after_cases[case_id].get("image", {}).get("sha256")]
    if changed_images:
        print("\nChanged validation images: " + ", ".join(changed_images))

    changed_counters = []
    for case_id in before_cases:
        names = {entry["name"] for repetition in before_cases[case_id]["repetitions"] for entry in repetition.get("counters", [])}
        for name in sorted(names):
            if name == "DeviceAllocatedBytes":
                continue
            old = repetition_median(before_cases[case_id], "counters", name)
            new = repetition_median(after_cases[case_id], "counters", name)
            if old is not None and new is not None and abs(new - old) > max(0.5, abs(old) * 0.001):
                changed_counters.append(f"{case_id}/{name}: {old:g} -> {new:g}")
    if changed_counters:
        print("\nChanged workload counters:")
        for change in changed_counters:
            print(f"  {change}")


def list_cases(args: argparse.Namespace) -> None:
    manifest = load_manifest(args.scene_root.resolve())
    for case in manifest["cases"]:
        options = [
            case["scene"],
            case.get("camera", "default camera"),
            case.get("shading", "solid"),
            case.get("action", "steady"),
        ]
        print(f"{case['id']:30} {' / '.join(options)}")


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    sub = result.add_subparsers(dest="command", required=True)
    list_parser = sub.add_parser("list", help="list manifest benchmark cases")
    list_parser.add_argument("--scene-root", type=Path, default=DEFAULT_SCENES)
    list_parser.set_defaults(function=list_cases)

    run_parser = sub.add_parser("run", help="run the suite, selected cases, or one ad-hoc scene")
    run_parser.add_argument("cases", nargs="*", help="case IDs; empty runs the whole manifest")
    run_parser.add_argument("--scene", type=Path, help="run an arbitrary scene instead of manifest cases")
    run_parser.add_argument("--id", help="result ID for --scene")
    run_parser.add_argument("--camera")
    run_parser.add_argument(
        "--shading",
        choices=("wireframe", "solid", "preview", "rendered"),
        default="solid",
    )
    run_parser.add_argument(
        "--action",
        choices=("steady", "orbit", "transform", "visibility", "playback"),
        default="steady",
    )
    run_parser.add_argument("--action-count", type=int, default=64)
    run_parser.add_argument("--overlays", action="store_true")
    run_parser.add_argument("--edit", choices=("vertex", "edge", "face"))
    run_parser.add_argument("--select-all", action="store_true")
    run_parser.add_argument("--motion-blur", type=int)
    run_parser.add_argument("--frames", type=int, default=400)
    run_parser.add_argument("--warmup-frames", type=int, default=30)
    run_parser.add_argument("--reps", type=int, default=1)
    run_parser.add_argument("--scene-root", type=Path, default=DEFAULT_SCENES)
    run_parser.add_argument("--exe", type=Path, default=DEFAULT_EXE)
    run_parser.add_argument("--output", type=Path)
    run_parser.add_argument("--no-build", action="store_true")
    run_parser.add_argument("--no-images", action="store_true")
    run_parser.set_defaults(function=run)

    compare_parser = sub.add_parser("compare", help="compare two result files")
    compare_parser.add_argument("before", type=Path)
    compare_parser.add_argument("after", type=Path)
    compare_parser.set_defaults(function=compare)
    return result


if __name__ == "__main__":
    args = parser().parse_args()
    args.function(args)
