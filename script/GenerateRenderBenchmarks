MARKER = ".generated-by-GenerateRenderBenchmarks"


@dataclass(frozen=True)
class Profile:
    instance_dims: tuple[int, int, int]
    draw_items: int
    terrain_size: tuple[int, int]
    large_meshes: int
    large_mesh_size: tuple[int, int]
    occlusion_instances: int
    editor_edit_meshes: int
    editor_wireframe_meshes: int
    editor_grid: int
    transparent_items: int
    deformation_meshes: int
    deformation_size: tuple[int, int]


PROFILES = {
