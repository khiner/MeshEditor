<?xml version="1.0"?>
<materialx version="1.39">
  <!--
    Nodes that only the tests load, whose graphs nest sources no shipped graph nests.
  -->

  <nodedef name="ND_testsecondtexcoord_vector2" node="testsecondtexcoord" nodegroup="geometric" doc="The second texture coordinates.">
    <output name="out" type="vector2" />
  </nodedef>
  <nodegraph name="NG_testsecondtexcoord_vector2" nodedef="ND_testsecondtexcoord_vector2">
    <texcoord name="second" type="vector2">
      <input name="index" type="integer" value="1" />
    </texcoord>
    <output name="out" type="vector2" nodename="second" />
  </nodegraph>

  <nodedef name="ND_testcolor_color4" node="testcolor" nodegroup="geometric" doc="The first color.">
    <output name="out" type="color4" />
  </nodedef>
  <nodegraph name="NG_testcolor_color4" nodedef="ND_testcolor_color4">
    <geomcolor name="color" type="color4">
      <input name="index" type="integer" value="0" />
    </geomcolor>
    <output name="out" type="color4" nodename="color" />
  </nodegraph>
</materialx>
